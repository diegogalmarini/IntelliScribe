{
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/$1" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
    ],
    "functions": {
        "api/ai.ts": {
            "maxDuration": 300,
            "memory": 1024
        },
        "api/support-chat.ts": {
            "maxDuration": 30,
            "memory": 512
        }
    }
}
