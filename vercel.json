{
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/assets/(.*)",
            "status": 404
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "functions": {
        "api/ai.ts": {
            "maxDuration": 300,
            "memory": 1024
        },
        "api/support-chat.ts": {
            "maxDuration": 30,
            "memory": 512,
            "includeFiles": "api/_data/**"
        },
        "api/cron-cleanup-free.ts": {
            "maxDuration": 300,
            "memory": 1024
        },
        "api/cron-reset-usage.ts": {
            "maxDuration": 60
        }
    },
    "regions": [
        "arn1"
    ],
    "crons": [
        {
            "path": "/api/cron-reset-usage",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron-cleanup-free",
            "schedule": "30 3 * * *"
        }
    ]
}
