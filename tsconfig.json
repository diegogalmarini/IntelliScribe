{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // Sin `exclude`, el include implícito es "**/*" y se compilaban también
  // chrome-extension/ (que tiene su propio tsconfig con strict) y
  // supabase/functions/ (Deno: imports por URL y el global Deno), que juntas
  // aportaban ~102 errores ajenos a la app.
  "exclude": [
    "node_modules",
    "dist",
    "backups",
    "chrome-extension",
    "supabase/functions",
    ".claude"
  ]
}